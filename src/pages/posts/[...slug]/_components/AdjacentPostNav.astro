---
import IconArrowLeft from "@/assets/icons/IconArrowLeft.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import { getPostUrl } from "@/utils/getPostPaths";
import { useTranslations } from "@/i18n";
import config from "@/config";

type AdjacentPost = {
  id: string;
  title: string;
  filePath: string | undefined;
} | null;

type Props = {
  prevPost: AdjacentPost;
  nextPost: AdjacentPost;
};

const { prevPost, nextPost } = Astro.props;
const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
---

<div
  data-pagefind-ignore
  class="my-8 grid grid-cols-2 items-start gap-4 sm:gap-6"
>
  {
    prevPost && (
      <a
        href={getPostUrl(prevPost.id, prevPost.filePath, locale)}
        class="flex min-w-0 items-start gap-1 hover:opacity-75"
      >
        <IconArrowLeft class="inline-block flex-none rtl:rotate-180" />
        <div class="min-w-0">
          <span>{t.post.previousPost}</span>
          <div class="text-accent/85 text-sm wrap-anywhere">
            {prevPost.title}
          </div>
        </div>
      </a>
    )
  }
  {
    nextPost && (
      <a
        href={getPostUrl(nextPost.id, nextPost.filePath, locale)}
        class="col-start-2 flex min-w-0 items-start justify-end gap-1 text-end hover:opacity-75"
      >
        <div class="min-w-0">
          <span>{t.post.nextPost}</span>
          <div class="text-accent/85 text-sm wrap-anywhere">
            {nextPost.title}
          </div>
        </div>
        <IconArrowRight class="inline-block flex-none rtl:rotate-180" />
      </a>
    )
  }
</div>
